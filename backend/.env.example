# AgriPulse Environment Configuration Example
# Copy to .env and configure for your local environment

APP_NAME=AgriPulse
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security & Authentication
JWT_SECRET_KEY=development_secret_key_change_in_production_environment_98234
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL in production / SQLite for local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agripulse_db
# SQLite fallback example:
# DATABASE_URL=sqlite:///./agripulse_dev.db

# External Services
WEATHER_API_KEY=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:4200
